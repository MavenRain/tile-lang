-- Tiles: a Tile r c U32 holds a U32 at each index (i, j), i < r, j < c. A
-- program makes and changes tiles only with the domain generators
-- (domain/domain.lang). The checker refuses a program that names the kit
-- basis (REFUSE_BASIS). A program cannot read one cell, so each test compares
-- two whole tiles. There is one Eq test for each generator. Each proof is refl.
def ofNat : Nat -> U32 := fun n => fold (fun x => u32Add x 1u) 0u n
-- a23 has the cells 1 to 6 in row order, b32 has the cells 7 to 12.
def a23 : Tile 2 3 U32 := kernel 2 3 1 1 (fun i j => fill 1 1 (ofNat (natAdd (natMul i 3) (natAdd j 1))))
def b32 : Tile 3 2 U32 := kernel 3 2 1 1 (fun i j => fill 1 1 (ofNat (natAdd (natMul i 2) (natAdd j 7))))
def eye : Tile 2 2 U32 := kernel 2 2 1 1 (fun i j => fill 1 1 (flagIf (natEq i j) 1u 0u))
def ab : Tile 2 2 U32 := gemm 2 3 2 a23 b32
def sum23 : Tile 1 1 U32 := reduce 2 3 (fun x y => u32Add x y) 0u a23
def copyId : Eq (Tile 2 3 U32) (copy 2 3 a23) a23 := refl
def tmapCells : Eq (Tile 2 3 U32) (tmap 2 3 (fun x => u32Mul x 2u) a23) (kernel 2 3 1 1 (fun i j => fill 1 1 (ofNat (natMul 2 (natAdd (natMul i 3) (natAdd j 1)))))) := refl
def fillCells : Eq (Tile 2 3 U32) (fill 2 3 5u) (tmap 2 3 (fun x => 5u) a23) := refl
def taddCells : Eq (Tile 2 3 U32) (tadd 2 3 a23 a23) (tmap 2 3 (fun x => u32Mul x 2u) a23) := refl
def tsubCells : Eq (Tile 2 3 U32) (tsub 2 3 a23 a23) (fill 2 3 0u) := refl
def tmulCells : Eq (Tile 2 3 U32) (tmul 2 3 a23 a23) (tmap 2 3 (fun x => u32Mul x x) a23) := refl
def gemmCells : Eq (Tile 2 2 U32) ab (kernel 2 2 1 1 (fun i j => fill 1 1 (flagIf (natEq i 0) (flagIf (natEq j 0) 58u 64u) (flagIf (natEq j 0) 139u 154u)))) := refl
def gemmAccCells : Eq (Tile 2 2 U32) (gemmAcc 2 3 2 eye a23 b32) (kernel 2 2 1 1 (fun i j => fill 1 1 (flagIf (natEq i 0) (flagIf (natEq j 0) 59u 64u) (flagIf (natEq j 0) 139u 155u)))) := refl
def reduceSum : Eq (Tile 1 1 U32) sum23 (fill 1 1 21u) := refl
-- The fold is in row order. Each step gives the cell minus the accumulator:
-- over the cells 1 to 6 that is 3 (the column order gives 9).
def reduceOrder : Eq (Tile 1 1 U32) (reduce 2 3 (fun x y => u32Sub y x) 0u a23) (fill 1 1 3u) := refl
def viewCells : Eq (Tile 2 2 U32) (view 2 3 0 1 1 1 2 2 a23) (kernel 2 2 1 1 (fun i j => fill 1 1 (ofNat (natAdd (natMul i 3) (natAdd j 2))))) := refl
def viewStride : Eq (Tile 2 2 U32) (view 2 3 0 0 1 2 2 2 a23) (kernel 2 2 1 1 (fun i j => fill 1 1 (ofNat (natAdd (natMul i 3) (natAdd (natMul j 2) 1))))) := refl
def trCells : Eq (Tile 3 2 U32) (tr 2 3 a23) (kernel 3 2 1 1 (fun i j => fill 1 1 (ofNat (natAdd (natMul j 3) (natAdd i 1))))) := refl
def kernelRows : Eq (Tile 2 3 U32) (kernel 2 1 1 3 (fun bi bj => view 2 3 bi 0 1 1 1 3 a23)) a23 := refl
def kernelReverse : Eq (Tile 2 3 U32) (kernel 1 3 2 1 (fun bi bj => view 2 3 0 (natSub 2 bj) 1 1 2 1 a23)) (kernel 2 3 1 1 (fun i j => fill 1 1 (ofNat (natAdd (natMul i 3) (natSub 3 j))))) := refl
