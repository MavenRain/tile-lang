-- Generic families remain a host capability even though the tile domain
-- declares none. These cases preserve the sample-domain regressions.
family Color := red | green | blue
family Item := makeItem (itemColor : Color) (itemPrice : Nat) (itemCount : Nat)
family Stack := bottom | push (top : Nat) (rest : Stack)
family Lot (size : Nat) := makeLot (lotPrice : Nat)
def lineTotal : Item -> Nat := fun item => natMul (itemPrice item) (itemCount item)
def isRed : Color -> Flag := fun color => fold flagYes flagNo flagNo color
def total : List Item -> Nat := fun items => fold (fun item acc => natAdd (lineTotal item) acc) 0 items
def redTotal : List Item -> Nat := fun items => total (filter (fun item => isRed (itemColor item)) items)
def depth : Stack -> Nat := fun s => fold 0 (fun top acc => natAdd acc 1) s
def stock : List Item := cons (makeItem red 3 10) (cons (makeItem blue 1 40) nil)
def stockTotal : Eq Nat (total stock) 70 := refl
def stockRed : Eq Nat (redTotal stock) 30 := refl
def pileDepth : Eq Nat (depth (push 1 (push 2 bottom))) 2 := refl
def lotCost : Eq Nat (lotPrice (makeLot 3 250)) 250 := refl
def indexedMaker : (n : Nat) -> Nat -> Lot n := fun n price => makeLot n price
def indexedLot : Eq (Lot 3) (indexedMaker 3 250) (makeLot 3 250) := refl
